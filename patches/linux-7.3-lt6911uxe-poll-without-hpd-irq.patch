From: John Rinehart <johnrichardrinehart@gmail.com>
Subject: [PATCH] media: i2c: lt6911uxe: poll a UXE that has no HPD IRQ

The driver updates the mode of an LT6911UXE only from its HPD IRQ
handler, and query_dv_timings() returns -ENOIOCTLCMD for a UXE. Some
NanoKVM units have a UXE (chip ID 0x2102) where others have a UXC, and
their device tree gives no HPD GPIO. On these units the mode stays
empty, so userspace never sees a signal.

When a UXE has no HPD IRQ, let query_dv_timings() read the mode as it
does for a UXC. REG_INT_HDMI and the timing registers hold the current
state (checked on hardware with a 1080p60 source), so a poll reads them
like the IRQ handler. A poll sends the source-change event only when the
mode changes, and returns -ENOLINK when there is no signal.

--- a/drivers/media/i2c/lt6911uxe.c
+++ b/drivers/media/i2c/lt6911uxe.c
@@ -272,8 +272,12 @@
 	bool mode_changed = false;
 	int ret;
 
-	/* UXC has no HPD IRQ; UXE refreshes cur_mode from its IRQ handler. */
-	if (!lt6911uxe->is_uxc)
+	/*
+	 * UXC has no HPD IRQ, and a UXE wired without one (NanoKVM) has no
+	 * other way to learn its mode: both refresh cur_mode here. A UXE
+	 * with an HPD IRQ refreshes cur_mode from its IRQ handler.
+	 */
+	if (!lt6911uxe->is_uxc && lt6911uxe->irq_gpio)
 		return -ENOIOCTLCMD;
 
 	ret = pm_runtime_resume_and_get(&client->dev);
@@ -312,6 +316,7 @@
 	u64 int_event;
 	u64 byte_clk, half_pix_clk, fps, format;
 	u64 half_htotal, vtotal, half_width, height;
+	struct lt6911uxe_mode old_mode;
 	int ret = 0;
 
 	if (lt6911uxe->is_uxc) {
@@ -385,6 +390,14 @@
 		return ret;
 	}
 
+	/*
+	 * REG_INT_HDMI and the timing registers hold the current state, so a
+	 * poll (mode_changed set) reads them like the IRQ handler does.
+	 */
+	if (mode_changed)
+		*mode_changed = false;
+	old_mode = lt6911uxe->cur_mode;
+
 	/* Read interrupt event */
 	cci_read(lt6911uxe->regmap, REG_INT_HDMI, &int_event, &ret);
 	if (ret) {
@@ -461,6 +474,14 @@
 	default:
 		ret = -ENOLINK;
 	}
+	if (mode_changed) {
+		/* The caller sends the source-change event on a change. */
+		*mode_changed = !lt6911uxe_mode_equal(&old_mode,
+						      &lt6911uxe->cur_mode);
+		if (!ret && !lt6911uxe->cur_mode.width)
+			ret = -ENOLINK;
+		return ret;
+	}
 	v4l2_subdev_notify_event(&lt6911uxe->sd, &lt6911uxe_ev_source_change);
 	return ret;
 }
